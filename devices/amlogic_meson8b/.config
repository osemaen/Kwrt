
CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson8b=y
CONFIG_TARGET_amlogic_meson8b_DEVICE_thunder-onecloud=y

# 仅构建玩客云及已选软件包，避免 Kwrt 公共配置展开全部目标和调试包
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_ALL_NONSHARED=n
CONFIG_PACKAGE_perf=n

# 使用标准 firewall4 masquerade，不编译与 6.6 内核不兼容的旧 FullCone 扩展
CONFIG_PACKAGE_firewall=n
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_miniupnpd-iptables=n
CONFIG_PACKAGE_kmod-nft-fullcone=n
CONFIG_PACKAGE_kmod-ipt-fullconenat=n
CONFIG_PACKAGE_iptables-mod-fullconenat=n
CONFIG_PACKAGE_ip6tables-mod-fullconenat=n

CONFIG_TARGET_ROOTFS_SQUASHFS=n
CONFIG_TARGET_ROOTFS_EXT4FS=y

# 旁路由仅使用 IPv4
CONFIG_IPV6=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_luci-proto-ipv6=n

# 互联网插件：OpenClash 与 Momo 仅预装，不同时启用
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_momo=y
CONFIG_PACKAGE_luci-app-momo=y
CONFIG_PACKAGE_sing-box=y
CONFIG_SINGBOX_WITH_TAILSCALE=n

# Liquid Formula
CONFIG_PACKAGE_liquid-formula=y
CONFIG_PACKAGE_luci-app-liquid-formula=y

# 公网访问、磁盘与 Docker
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-docker=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_usbutils=y
